# Copie este arquivo para ".env" e preencha com os seus dados.
# O arquivo ".env" NUNCA deve ser enviado ao GitHub.

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Chave secreta: usada só no servidor para gravar os pedidos
SUPABASE_SERVICE_KEY=

# Texto longo e aleatório que protege o login (cookie de sessão)
SESSION_SECRET=

# MongoDB Atlas (Connect > Drivers)
MONGODB_URI=
MONGODB_DB=gamebox

# Redis Cloud (Database > Security)
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# WhatsApp que recebe os pedidos: só números, com código do país e DDD
# Exemplo: 5586912345678
WHATSAPP_NUMERO=

# Porta do servidor (opcional)
PORT=3000
