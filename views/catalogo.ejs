<%# Página inicial da loja. %>
<%# Recebe do servidor: produtos (vitrine), vistos e maisVistos. %>
<%- include('partials/topo') %>

<%# Destaque: apresentação da loja e as fotos dos 3 produtos mais recentes %>
<section class="hero">
  <div>
    <span class="pill">Novidades na loja</span>
    <h1>Tecnologia e games <em>ao seu alcance</em></h1>
    <p class="hero-lead">Escolha seus produtos, monte o carrinho e finalize o pedido direto pelo WhatsApp.</p>
    <a class="btn btn-lg" href="/produtos">Explorar produtos</a>
  </div>

  <% if (produtos.length > 0) { %>
    <div class="hero-art">
      <% produtos.slice(0, 3).forEach((p) => { %>
        <a class="shot" href="/produto/<%= p._id %>" title="<%= p.nome %>">
          <img src="<%= p.imagem %>" alt="<%= p.nome %>">
        </a>
      <% }) %>
    </div>
  <% } %>
</section>

<%# Atalhos compactos: "Mais vistos" vem do ranking no Redis e "Vistos recentemente" vem %>
<%# da lista de cada visitante (também no Redis). Sem dados, o bloco nem aparece %>
<% if (maisVistos.length > 0 || vistos.length > 0) { %>
  <div class="quick">

    <% if (maisVistos.length > 0) { %>
      <div class="quick-row">
        <span class="quick-label">Mais vistos</span>
        <div class="chips">
          <% maisVistos.forEach((m, i) => { %>
            <a class="chip" href="/produto/<%= m._id %>" title="<%= m.nome %>">
              <img src="<%= m.imagem %>" alt="" loading="lazy">
              <span class="chip-name"><span class="chip-rank"><%= i + 1 %>º</span> <%= m.nome %></span>
              <span class="chip-meta"><%= m.visualizacoes %> <%= m.visualizacoes === 1 ? "visualização" : "visualizações" %></span>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

    <% if (vistos.length > 0) { %>
      <div class="quick-row">
        <span class="quick-label">Vistos recentemente</span>
        <div class="chips">
          <% vistos.forEach((v) => { %>
            <a class="chip" href="/produto/<%= v._id %>" title="<%= v.nome %>">
              <img src="<%= v.imagem %>" alt="" loading="lazy">
              <span class="chip-name"><%= v.nome %></span>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

  </div>
<% } %>

<%# Vitrine: os lançamentos mais recentes (lidos do cache do Redis quando possível) %>
<section style="margin-top: 36px;">
  <div class="section-head section-head-row">
    <div>
      <span class="eyebrow">Lançamentos</span>
      <h2>Chegou na loja</h2>
    </div>
    <a class="link-all" href="/produtos">Ver todos os produtos</a>
  </div>

  <% if (produtos.length === 0) { %>
    <p class="empty">Nenhum produto cadastrado ainda.</p>
  <% } %>

  <div class="grid">
    <% produtos.forEach((p) => { %>
      <%# Cada produto é desenhado pelo partial card.ejs %>
      <%- include('partials/card', { p }) %>
    <% }) %>
  </div>
</section>

<%- include('partials/rodape') %>