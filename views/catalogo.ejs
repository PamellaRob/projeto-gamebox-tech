<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title><%= titulo %></title>
</head>
<body>
  <h1><%= titulo %></h1>
  <p><a href="/carrinho">🛒 Carrinho (<%= qtdCarrinho %>)</a></p>

  <form method="GET" action="/" style="margin: 16px 0;">
    <input type="text" name="q" placeholder="Buscar produto..." value="<%= filtros.q %>">

    <select name="categoria">
      <option value="">Todas as categorias</option>
      <option value="jogos" <%= filtros.categoria === "jogos" ? "selected" : "" %>>Jogos</option>
      <option value="eletronicos" <%= filtros.categoria === "eletronicos" ? "selected" : "" %>>Eletrônicos</option>
    </select>

    <% if (plataformas.length > 0) { %>
      <select name="plataforma">
        <option value="">Todas as plataformas</option>
        <% plataformas.forEach((pl) => { %>
          <option value="<%= pl %>" <%= filtros.plataforma === pl ? "selected" : "" %>><%= pl %></option>
        <% }) %>
      </select>
    <% } %>

    <select name="ordem">
      <option value="recentes" <%= filtros.ordem === "recentes" ? "selected" : "" %>>Mais recentes</option>
      <option value="menor" <%= filtros.ordem === "menor" ? "selected" : "" %>>Menor preço</option>
      <option value="maior" <%= filtros.ordem === "maior" ? "selected" : "" %>>Maior preço</option>
      <option value="nome" <%= filtros.ordem === "nome" ? "selected" : "" %>>Nome (A-Z)</option>
    </select>

    <button type="submit">Filtrar</button>
    <% if (temFiltro) { %><a href="/">Limpar filtros</a><% } %>
  </form>

  <% if (vistos.length > 0 && !temFiltro) { %>
    <h2>Vistos recentemente</h2>
    <div style="display: flex; gap: 12px; flex-wrap: wrap;">
      <% vistos.forEach((v) => { %>
        <a href="/produto/<%= v._id %>" style="text-align: center; width: 100px; font-size: 13px;">
          <img src="<%= v.imagem %>" alt="<%= v.nome %>" width="80"><br>
          <%= v.nome %>
        </a>
      <% }) %>
    </div>
    <hr>
  <% } %>

  <% if (temFiltro) { %>
    <p><strong><%= produtos.length %></strong> produto(s) encontrado(s).</p>
  <% } %>

  <% if (produtos.length === 0) { %>
    <p><%= temFiltro ? "Nenhum produto encontrado com esses filtros." : "Nenhum produto cadastrado ainda." %></p>
  <% } %>

  <% produtos.forEach((p) => { %>
    <div style="border: 1px solid #ccc; padding: 12px; margin: 12px 0; max-width: 400px;">
      <img src="<%= p.imagem %>" alt="<%= p.nome %>" width="200"><br>
      <h3><a href="/produto/<%= p._id %>"><%= p.nome %></a></h3>
      <p><%= p.descricao %></p>
      <strong><%= p.preco.toLocaleString("pt-BR", { style: "currency", currency: "BRL" }) %></strong>

      <% if (p.estoque > 0) { %>
        <form method="POST" action="/carrinho/adicionar/<%= p._id %>">
          <button type="submit">Adicionar ao carrinho</button>
        </form>
      <% } else { %>
        <em>Esgotado</em>
      <% } %>
    </div>
  <% }) %>
</body>
</html>