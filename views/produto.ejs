<%- include('partials/topo') %>

<a class="back" href="/produtos">← Voltar aos produtos</a>

<div class="product">
  <div class="product-img">
    <img src="<%= produto.imagem %>" alt="<%= produto.nome %>">
  </div>

  <div>
    <span class="tag"><%= produto.categoria === "jogos" ? "Jogos" : "Eletrônicos" %></span>
    <h1><%= produto.nome %></h1>
    <p class="price-lg"><%= produto.preco.toLocaleString("pt-BR", { style: "currency", currency: "BRL" }) %></p>
    <p><%= produto.descricao %></p>

    <% const atributos = Object.entries(produto.atributos || {}); %>
    <% if (atributos.length > 0) { %>
      <table class="specs">
        <% atributos.forEach(([chave, valor]) => { %>
          <tr><th><%= chave %></th><td><%= valor %></td></tr>
        <% }) %>
      </table>
    <% } %>

    <% if (produto.estoque > 0) { %>
      <p class="stock">Em estoque: <%= produto.estoque %> unidade(s)</p>
      <form method="POST" action="/carrinho/adicionar/<%= produto._id %>">
        <button type="submit" class="btn">Adicionar ao carrinho</button>
      </form>
    <% } else { %>
      <p class="soldout">Esgotado</p>
    <% } %>
  </div>
</div>

<%- include('partials/rodape') %>