<%# Carrinho de compras. Recebe do servidor: itens (produto, qtd, subtotal), total e a função brl (formata em reais) %>
<%# O preço sempre vem do MongoDB, nunca do navegador %>
<%- include('partials/topo') %>

<h1>Meu carrinho</h1>
<p><a class="back" href="/produtos">← Continuar comprando</a></p>

<%# Carrinho vazio ou com itens %>
<% if (itens.length === 0) { %>
  <p class="empty">Seu carrinho está vazio.</p>
<% } else { %>
  <div class="table-wrap">
    <table class="data">
      <tr>
        <th>Produto</th><th>Preço</th><th>Quantidade</th><th>Subtotal</th><th></th>
      </tr>
      <% itens.forEach(({ produto, qtd, subtotal }) => { %>
        <tr>
          <td>
            <div class="cell-product">
              <img class="thumb" src="<%= produto.imagem %>" alt="<%= produto.nome %>">
              <a href="/produto/<%= produto._id %>"><%= produto.nome %></a>
            </div>
          </td>
          <td><%= brl(produto.preco) %></td>
          <td>
            <%# Botão + desativado quando a quantidade já chegou ao estoque %>
            <div class="qty">
              <form class="inline" method="POST" action="/carrinho/diminuir/<%= produto._id %>">
                <button type="submit" class="btn btn-ghost btn-sm">−</button>
              </form>
              <strong><%= qtd %></strong>
              <form class="inline" method="POST" action="/carrinho/adicionar/<%= produto._id %>">
                <button type="submit" class="btn btn-ghost btn-sm" <%= qtd >= produto.estoque ? "disabled" : "" %>>+</button>
              </form>
            </div>
          </td>
          <td><%= brl(subtotal) %></td>
          <td>
            <form class="inline" method="POST" action="/carrinho/remover/<%= produto._id %>">
              <button type="submit" class="btn btn-danger btn-sm">Remover</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </table>
  </div>

  <%# Total e finalização: o botão envia o pedido ao servidor, que salva no Supabase %>
  <%# e abre o WhatsApp com a mensagem pronta %>
  <div class="summary">
    <div>
      <div style="color: var(--muted);">Total do pedido</div>
      <div class="total"><%= brl(total) %></div>
    </div>

    <form method="POST" action="/carrinho/finalizar">
      <div class="field" style="margin: 0;">
        <label for="nome">Seu nome (opcional)</label>
        <input type="text" id="nome" name="nome" maxlength="80">
      </div>
      <button type="submit" class="btn btn-whatsapp">Comprar pelo WhatsApp</button>
    </form>
  </div>
<% } %>

<%- include('partials/rodape') %>