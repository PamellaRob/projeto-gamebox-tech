<%- include('partials/topo', { titulo: "Pedidos", ativo: "pedidos" }) %>

<div class="adm-toolbar">
  <div class="adm-tabs">
    <a class="adm-tab <%= status === '' ? 'is-on' : '' %>" href="/admin/pedidos">Todos<em><%= resumo.total %></em></a>
    <% statusLista.forEach((s) => { %>
      <a class="adm-tab <%= status === s ? 'is-on' : '' %>" href="/admin/pedidos?status=<%= s %>"><%= rotuloStatus(s) %><em><%= resumo.porStatus[s] || 0 %></em></a>
    <% }) %>
  </div>
</div>

<section class="adm-card">
  <% if (pedidos.length === 0) { %>
    <p class="adm-empty"><%= status ? "Nenhum pedido com este status." : "Nenhum pedido registrado ainda." %></p>
  <% } else { %>
    <div class="adm-table-wrap">
      <table class="adm-table">
        <thead>
          <tr><th>Nº</th><th>Data</th><th>Cliente</th><th class="num">Total</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
          <% pedidos.forEach((p) => { %>
            <tr>
              <td><a href="/admin/pedidos/<%= p.id %>"><strong>#<%= p.id %></strong></a></td>
              <td><%= dataHora(p.criado_em) %></td>
              <td><%= p.cliente_nome || "Não informado" %></td>
              <td class="num"><%= brl(p.total) %></td>
              <td><span class="st st-<%= p.status %>"><%= rotuloStatus(p.status) %></span></td>
              <td><div class="adm-actions"><a class="abtn abtn-ghost abtn-sm" href="/admin/pedidos/<%= p.id %>">Ver detalhes</a></div></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('partials/rodape') %>
