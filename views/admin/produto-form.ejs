<%# Formulário usado para cadastrar e editar produtos. %>
<%# Recebe: titulo, acao (para onde enviar), botao (texto), produto, caracteristicas, erro e sucesso. %>
<%- include('partials/topo', { titulo: titulo, ativo: "produtos" }) %>

<%# No cadastro "produto" é nulo; um objeto vazio deixa os campos em branco %>
<% const p = produto || {}; %>

<p><a href="/admin/produtos">← Voltar para a lista</a></p>

<% if (locals.erro) { %><div class="adm-alert adm-alert-erro"><%= locals.erro %></div><% } %>
<% if (locals.sucesso) { %><div class="adm-alert adm-alert-ok"><%= locals.sucesso %></div><% } %>

<section class="adm-card adm-form">
  <div class="adm-card-body">
    <form method="POST" action="<%= acao %>">

      <div class="adm-field">
        <label for="nome">Nome</label>
        <input id="nome" type="text" name="nome" value="<%= p.nome || '' %>" required>
      </div>

      <div class="adm-field">
        <label for="descricao">Descrição</label>
        <textarea id="descricao" name="descricao" rows="3" required><%= p.descricao || '' %></textarea>
      </div>

      <div class="adm-grid-2">
        <div class="adm-field">
          <label for="preco">Preço (R$)</label>
          <input id="preco" type="text" name="preco" placeholder="249,90"
                 value="<%= p.preco !== undefined ? String(p.preco).replace('.', ',') : '' %>" required>
        </div>
        <div class="adm-field">
          <label for="estoque">Estoque</label>
          <input id="estoque" type="number" name="estoque" min="0"
                 value="<%= p.estoque !== undefined ? p.estoque : 1 %>" required>
        </div>
      </div>

      <div class="adm-field">
        <label for="categoria">Categoria</label>
        <select id="categoria" name="categoria">
          <option value="jogos" <%= p.categoria === "jogos" ? "selected" : "" %>>Jogos</option>
          <option value="eletronicos" <%= p.categoria === "eletronicos" ? "selected" : "" %>>Eletrônicos</option>
        </select>
      </div>

      <div class="adm-field">
        <label for="imagem">URL da imagem</label>
        <input id="imagem" type="url" name="imagem" placeholder="https://..." value="<%= p.imagem || '' %>" required>
      </div>

      <div class="adm-field">
        <label for="caracteristicas">Características</label>
        <%# Uma característica por linha, no formato chave: valor. %>
        <%# O servidor transforma em objeto e salva dentro do documento no MongoDB %>
        <textarea id="caracteristicas" name="caracteristicas" rows="4"
                  placeholder="plataforma: PS5&#10;genero: Esporte"><%= caracteristicas %></textarea>
        <small>Uma por linha, no formato chave: valor. Elas ficam salvas dentro do documento no MongoDB.</small>
      </div>

      <div class="adm-form-actions">
        <button type="submit" class="abtn"><%= botao %></button>
        <a class="abtn abtn-ghost" href="/admin/produtos">Cancelar</a>
      </div>

    </form>
  </div>
</section>

<%- include('partials/rodape') %>
