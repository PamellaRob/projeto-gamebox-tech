<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title><%= titulo %></title>
</head>
<body>
  <% const p = produto || {}; %>

  <h1><%= titulo %></h1>
  <p><a href="/admin/produtos">← Voltar para a lista</a></p>

  <% if (erro) { %><p style="color: red;"><%= erro %></p><% } %>
  <% if (sucesso) { %><p style="color: green;"><%= sucesso %></p><% } %>

  <form method="POST" action="<%= acao %>">
    <label>Nome</label><br>
    <input type="text" name="nome" value="<%= p.nome || '' %>" required><br><br>

    <label>Descrição</label><br>
    <textarea name="descricao" rows="3" required><%= p.descricao || '' %></textarea><br><br>

    <label>Preço (R$)</label><br>
    <input type="text" name="preco" placeholder="249,90"
           value="<%= p.preco !== undefined ? String(p.preco).replace('.', ',') : '' %>" required><br><br>

    <label>Estoque</label><br>
    <input type="number" name="estoque" min="0"
           value="<%= p.estoque !== undefined ? p.estoque : 1 %>" required><br><br>

    <label>Categoria</label><br>
    <select name="categoria">
      <option value="jogos" <%= p.categoria === "jogos" ? "selected" : "" %>>Jogos</option>
      <option value="eletronicos" <%= p.categoria === "eletronicos" ? "selected" : "" %>>Eletrônicos</option>
    </select><br><br>

    <label>URL da imagem</label><br>
    <input type="url" name="imagem" placeholder="https://..." value="<%= p.imagem || '' %>" required><br><br>

    <label>Características (uma por linha, no formato chave: valor)</label><br>
    <textarea name="caracteristicas" rows="4" placeholder="plataforma: PS5&#10;genero: Esporte"><%= caracteristicas %></textarea><br><br>

    <button type="submit"><%= botao %></button>
  </form>
</body>
</html>