<%- include('partials/topo', { titulo: "Pedido #" + pedido.id, ativo: "pedidos" }) %>

<p><a href="/admin/pedidos">← Voltar para os pedidos</a></p>

<% if (locals.msg) { %><div class="adm-alert adm-alert-ok"><%= locals.msg %></div><% } %>

<div class="adm-cols">

  <section class="adm-card">
    <div class="adm-card-head"><h2>Itens do pedido</h2></div>
    <div class="adm-card-body" style="padding-left: 0; padding-right: 0; padding-bottom: 0;">
      <div class="adm-table-wrap">
        <table class="adm-table">
          <thead>
            <tr><th>Produto</th><th class="num">Preço unit.</th><th class="num">Qtd</th><th class="num">Subtotal</th></tr>
          </thead>
          <tbody>
            <% pedido.itens_pedido.forEach((i) => { %>
              <tr>
                <td><strong><%= i.produto_nome %></strong></td>
                <td class="num"><%= brl(i.preco_unitario) %></td>
                <td class="num"><%= i.quantidade %></td>
                <td class="num"><%= brl(Number(i.preco_unitario) * i.quantidade) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="adm-total-line">
        <span class="adm-muted">Total do pedido</span>
        <strong><%= brl(pedido.total) %></strong>
      </div>
    </div>
  </section>

  <div class="adm-stack">

    <section class="adm-card">
      <div class="adm-card-head"><h2>Detalhes</h2></div>
      <div class="adm-card-body">
        <dl class="adm-dl">
          <div><dt>Status atual</dt><dd><span class="st st-<%= pedido.status %>"><%= rotuloStatus(pedido.status) %></span></dd></div>
          <div><dt>Cliente</dt><dd><%= pedido.cliente_nome || "Não informado" %></dd></div>
          <div><dt>Data</dt><dd><%= dataHora(pedido.criado_em) %></dd></div>
        </dl>
      </div>
    </section>

    <section class="adm-card">
      <div class="adm-card-head"><h2>Atualizar status</h2></div>
      <div class="adm-card-body">
        <form method="POST" action="/admin/pedidos/<%= pedido.id %>/status">
          <div class="adm-field">
            <label for="status">Novo status</label>
            <select id="status" name="status">
              <% statusLista.forEach((s) => { %>
                <option value="<%= s %>" <%= pedido.status === s ? "selected" : "" %>><%= rotuloStatus(s) %></option>
              <% }) %>
            </select>
          </div>
          <button type="submit" class="abtn abtn-block">Salvar status</button>
        </form>
      </div>
    </section>

  </div>

</div>

<%- include('partials/rodape') %>
